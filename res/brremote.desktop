[Desktop Entry]
Name=BR Remote
GenericName=Remote Desktop
Comment=Acesso remoto BR PROJ
Exec=brremote %u
Icon=brremote
Terminal=false
Type=Application
StartupNotify=true
Categories=Network;RemoteAccess;GTK;
Keywords=internet;remote-control;remote-desktop;acesso-remoto;suporte;brproj;
Actions=new-window;
StartupWMClass=brremote

X-Desktop-File-Install-Version=0.23

[Desktop Action new-window]
Name=Open a New Window
Exec=brremote %u
