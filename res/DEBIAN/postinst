#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/brremote/brremote /usr/bin/brremote

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/brremote.service ]; then
			rm /etc/systemd/system/brremote.service /usr/lib/systemd/system/brremote.service /usr/lib/systemd/user/brremote.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/brremote/files/systemd/brremote.service /usr/lib/systemd/system/brremote.service
		# try fix error in Ubuntu 18.04
		# Failed to reload brremote.service: Unit brremote.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/brremote.service:10: Executable path is not absolute: pkill -f "brremote --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/brremote.service
		fi
		systemctl daemon-reload
		systemctl enable brremote
		systemctl start brremote
	fi
fi
